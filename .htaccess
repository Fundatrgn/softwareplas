# Belge kökü bu klasörü (public/ yerine) gösteriyorsa tüm istekleri
# public/ klasörüne yönlendirir; .env gibi gizli dosyaları engeller.
# (Sadece mod_rewrite kullanır; Plesk'in kısıtlı .htaccess izinleriyle uyumludur.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan|package\.json) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/(error_docs|\.well-known)/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
