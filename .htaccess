# Alan adının belge kökü proje klasörünü (public/ yerine) gösteriyorsa:
# tüm istekleri public/ klasörüne yönlendirir; .env, vendor, storage gibi
# dosyalara tarayıcıdan erişilmesini engeller.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan|package\.json) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/(error_docs|\.well-known)/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
